# --- Cargo & Build Artifacts ---
# Contains all compiled files, binaries, and build artifacts
/target/
debug/

# --- Dependency Management ---
# UNCOMMENT the line below if you are building a LIBRARY.
# KEEP it commented out (do not ignore) if you are building an EXECUTABLE/BINARY.
# Cargo.lock

# --- Tooling & Diagnostics ---
# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds generate these for debugging information
*.pdb

# Rustc compiler internal error stack traces
rustc-ice-*.txt

# Mutation testing data generated by cargo-mutants
**/mutants.out*/

# Performance profiling & code coverage outputs
*.profraw
*.profdata
perf.data
perf.data.old
flamegraph.svg
coverage/
lcov.info
tarpaulin-report.html

# Criterion benchmark outputs
criterion/

# Local documentation generated by cargo doc
doc/

# --- IDE & Editor Settings ---
# VS Code (Ignores user settings but keeps workspace configs)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / RustRover / IntelliJ
.idea/
*.iml

# Rust-Analyzer specific project files
rust-project.json

crackme/*.dll
crackme/*.dll*